<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_card"
    android:orientation="vertical"
    android:padding="14dp">

    <TextView
        android:id="@+id/tvCaseTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/text_primary"
        android:textSize="15sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvCaseSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:lineSpacingMultiplier="1.4"
        android:textColor="@color/text_secondary"
        android:textSize="12.5sp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCaseAction"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="12dp"
        android:textAllCaps="false"
        android:textSize="14sp"
        app:cornerRadius="12dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCaseChat"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="8dp"
        android:text="@string/professional_btn_chat_reporter"
        android:textAllCaps="false"
        android:textColor="@color/link_color"
        android:textSize="14sp"
        android:visibility="gone"
        app:cornerRadius="12dp"
        app:icon="@drawable/ic_chat"
        app:iconGravity="textStart"
        app:iconSize="18dp"
        app:iconTint="@color/link_color"
        app:strokeColor="@color/field_border" />
</LinearLayout>
