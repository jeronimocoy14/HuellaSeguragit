<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <queries>
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE" />
        </intent>
    </queries>

    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.HUELLASEGURA">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".LoginActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".AccessibilityConfigActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".MainDashboardActivity"
            android:exported="false" />
        <activity
            android:name=".HomeSeniorActivity"
            android:exported="false" />
        <activity
            android:name=".ReportarPeligroActivity"
            android:exported="false" />
        <activity
            android:name=".ReportarPeligroSimpleActivity"
            android:exported="false" />
        <activity
            android:name=".ReportarPeligroUbicacionActivity"
            android:exported="false" />
        <activity
            android:name=".ReportarPeligroConfirmarActivity"
            android:exported="false" />
        <activity
            android:name=".BandejaProfesionalActivity"
            android:exported="false" />
        <activity
            android:name=".ProfileActivity"
            android:exported="false" />
        <activity
            android:name=".ReportSentActivity"
            android:exported="false" />
        <activity
            android:name=".MisMascotasActivity"
            android:exported="false" />
        <activity
            android:name=".AgregarMascotaActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".PerfilMascotaActivity"
            android:exported="false" />
        <activity
            android:name=".VeterinarioActivity"
            android:exported="false" />
        <activity
            android:name=".ChatActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".ChatsFuncionarioActivity"
            android:exported="false" />
        <activity
            android:name=".PerdidosActivity"
            android:exported="false" />
        <activity
            android:name=".ReportarPerdidoActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".PerdidoDetalleActivity"
            android:exported="false" />
        <activity
            android:name=".PerdidosModeracionActivity"
            android:exported="false" />
        <activity
            android:name=".ComunitariosActivity"
            android:exported="false" />
        <activity
            android:name=".SimpleListActivity"
            android:exported="false" />
        <activity
            android:name=".MapaReportesActivity"
            android:exported="false" />
        <activity
            android:name=".AgregarComunitarioActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".MisReportesActivity"
            android:exported="false" />
        <activity
            android:name=".CasosResueltosActivity"
            android:exported="false" />
        <activity
            android:name=".EstadisticasActivity"
            android:exported="false" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>